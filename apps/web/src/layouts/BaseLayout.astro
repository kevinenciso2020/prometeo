---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CampaignBar from '../components/CampaignBar.astro';
import CampaignPopup from '../components/CampaignPopup.astro';
import { byPlacement, pageCampaigns } from '../lib/campaigns';
import { SITE_NAME, SITE_TAGLINE, SITE_URL, getSettings, jsonLd } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** URL de imagen para Open Graph (ya transformada). */
  image?: string;
  nav?: string;
  noindex?: boolean;
  ogType?: 'website' | 'product' | 'article';
  structuredData?: unknown | unknown[];
  /** Páginas públicas cacheables en CDN; false para carrito/cuenta. */
  cacheable?: boolean;
}
const {
  title,
  description = 'Cerámica artesanal hecha a mano en Colombia: piezas únicas, cursos y talleres.',
  image,
  nav = '',
  noindex = false,
  ogType = 'website',
  structuredData,
  cacheable = true,
} = Astro.props;
const settings = await getSettings();
// Barra superior y popup solo en páginas públicas cacheables (no en carrito, checkout ni cuenta).
const campaigns = cacheable ? await pageCampaigns(Astro.locals, Astro.url.pathname) : [];
const bar = byPlacement(campaigns, 'barra_superior')[0];
const popup = byPlacement(campaigns, 'popup')[0];
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · ${SITE_TAGLINE}`;
const canonical = `${SITE_URL}${Astro.url.pathname}`;
const ld = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
if (cacheable) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Instrument+Serif&display=swap"
      rel="stylesheet"
    />
    {ld.map((d) => <script type="application/ld+json" set:html={jsonLd(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {bar && <CampaignBar campaign={bar} />}
    <SiteHeader current={nav} />
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter settings={settings} />
    {popup && <CampaignPopup campaign={popup} />}
    <script>
      import { initCampaignTracking } from '../lib/track';
      initCampaignTracking();
    </script>
  </body>
</html>
