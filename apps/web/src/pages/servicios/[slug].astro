---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/Picture.astro';
import AddToCart from '../../components/AddToCart.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { formatCop } from '@prometeo/shared';
import { apiGet, SITE_URL, type ServiceData } from '../../lib/site';
import { ogImage } from '../../lib/images';

const { slug } = Astro.params;
const res = await apiGet<{ item: ServiceData }>(`/public/services/${encodeURIComponent(slug ?? '')}`);
if (!res) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const s = res.item;
const images = s.images ?? [];
const description = (s.description || `${s.name} en Prometeo, taller de cerámica.`).slice(0, 160);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  description,
  provider: { '@type': 'Organization', name: 'Prometeo', url: SITE_URL },
  areaServed: 'CO',
  ...(s.price !== null && { offers: { '@type': 'Offer', priceCurrency: 'COP', price: s.price } }),
};
---

<BaseLayout title={s.name} nav="servicios" description={description} image={ogImage(images[0]?.url)} structuredData={ld}>
  <div class="container section">
    <nav class="crumbs" aria-label="Ruta"><a href="/servicios">Servicios</a></nav>
    <div class="layout">
      <div class="gallery">
        <Picture src={images[0]?.url} alt={images[0]?.alt ?? s.name} ratio="4 / 3" width={1024} sizes="(min-width: 60rem) 45vw, 100vw" eager class="main" />
        {images.length > 1 && (
          <div class="more">
            {images.slice(1, 5).map((img) => <Picture src={img.url} alt={img.alt ?? s.name} ratio="1 / 1" width={320} sizes="12rem" />)}
          </div>
        )}
      </div>
      <div class="info">
        <h1>{s.name}</h1>
        {s.price !== null && <p class="price">{s.mode === 'cotizacion' ? 'Desde ' : ''}<strong>{formatCop(s.price)}</strong></p>}
        <div class="prose"><p>{s.description}</p></div>

        {
          s.mode === 'pago_online' ? (
            <div class="card-box">
              <h2>Contratar</h2>
              <p>Paga en línea de forma segura. Este servicio no tiene costo de envío.</p>
              <AddToCart type="service" id={s.id} max={10} />
            </div>
          ) : (
            <div class="card-box">
              <h2>Solicita una cotización</h2>
              <QuoteForm serviceId={s.id} detailsLabel="Detalles de tu solicitud (personas, fecha, ideas…)" submitLabel="Pedir cotización" />
            </div>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .crumbs {
    font-size: var(--text-sm);
    margin-bottom: var(--space-5);
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: start;
  }
  :global(.main) {
    border: var(--border-w) solid var(--color-line);
  }
  .more {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .info {
    display: grid;
    gap: var(--space-4);
  }
  h1 {
    font-size: var(--text-2xl);
  }
  .price {
    font-size: var(--text-xl);
  }
  .prose p {
    white-space: pre-line;
  }
  .card-box {
    border: var(--border-w) solid var(--color-line);
    box-shadow: var(--shadow-hard);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  @media (max-width: 800px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
