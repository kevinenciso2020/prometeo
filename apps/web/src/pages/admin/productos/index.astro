---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Productos" active="productos">
  <div class="page-head">
    <h1>Productos</h1>
    <a class="btn btn--primary" href="/admin/productos/nuevo">Nuevo producto</a>
  </div>
  <form class="toolbar" id="filters">
    <input class="input" type="search" name="q" placeholder="Buscar por nombre o SKU" aria-label="Buscar" />
    <select class="select" name="status" aria-label="Estado">
      <option value="">Todos los estados</option>
      <option value="publicado">Publicado</option>
      <option value="borrador">Borrador</option>
      <option value="archivado">Archivado</option>
    </select>
    <button class="btn" type="submit">Filtrar</button>
  </form>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th></th><th>Producto</th><th>SKU</th><th class="num">Precio</th><th class="num">Stock</th><th>Estado</th><th></th></tr></thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
  <div class="pager"><button class="btn btn--sm" id="prev" type="button">Anterior</button><span id="info"></span><button class="btn btn--sm" id="next" type="button">Siguiente</button></div>

  <script>
    import { $, api, errorMessage, esc, formatCop, thumb, toast } from '../../../lib/admin-client';
    interface Row { id: string; name: string; sku: string | null; price: number; stock: number; status: string; thumb: string | null; isFeatured: boolean }
    interface Page { items: Row[]; page: number; totalPages: number; total: number }
    let page = 1;
    const form = $<HTMLFormElement>('#filters');

    async function load() {
      const p = new URLSearchParams({ page: String(page), pageSize: '15' });
      const d = new FormData(form);
      for (const k of ['q', 'status']) if (d.get(k)) p.set(k, String(d.get(k)));
      try {
        const r = await api<Page>(`/admin/products?${p}`);
        $('#rows').innerHTML = r.items.length
          ? r.items.map((x) => `<tr>
              <td>${x.thumb ? `<img class="thumb" src="${esc(thumb(x.thumb, 96))}" alt="" />` : '<div class="thumb"></div>'}</td>
              <td><a href="/admin/productos/${x.id}"><strong>${esc(x.name)}</strong></a>${x.isFeatured ? ' <span class="badge">Destacado</span>' : ''}</td>
              <td>${esc(x.sku ?? '—')}</td><td class="num">${formatCop(x.price)}</td><td class="num">${x.stock}</td>
              <td><span class="badge ${x.status === 'publicado' ? 'badge--solid' : 'badge--mute'}">${esc(x.status)}</span></td>
              <td class="actions"><a class="btn btn--sm" href="/admin/productos/${x.id}">Editar</a></td></tr>`).join('')
          : '<tr><td colspan="7" class="empty">No hay productos con estos filtros</td></tr>';
        $('#info').textContent = `Página ${r.page} de ${r.totalPages} · ${r.total} productos`;
        $<HTMLButtonElement>('#prev').disabled = r.page <= 1;
        $<HTMLButtonElement>('#next').disabled = r.page >= r.totalPages;
      } catch (err) {
        toast(errorMessage(err), 'error');
      }
    }
    form.addEventListener('submit', (e) => { e.preventDefault(); page = 1; void load(); });
    $('#prev').addEventListener('click', () => { page--; void load(); });
    $('#next').addEventListener('click', () => { page++; void load(); });
    void load();
  </script>
</AdminLayout>
