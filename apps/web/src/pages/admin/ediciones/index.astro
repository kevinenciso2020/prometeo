---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Ediciones" active="ediciones">
  <div class="page-head">
    <h1>Ediciones</h1>
    <a class="btn btn--primary" href="/admin/ediciones/nueva">Nueva edición</a>
  </div>
  <form class="toolbar" id="filters">
    <select class="select" name="status" aria-label="Estado">
      <option value="">Todos los estados</option>
      <option value="abierta">Abierta</option><option value="llena">Llena</option><option value="cerrada">Cerrada</option>
      <option value="finalizada">Finalizada</option><option value="cancelada">Cancelada</option>
    </select>
    <button class="btn" type="submit">Filtrar</button>
  </form>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Curso</th><th>Inicio</th><th>Ocupación</th><th class="num">En lista</th><th>Estado</th><th></th></tr></thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
  <script>
    import { $, api, errorMessage, esc, fmtBogota, toast } from '../../../lib/admin-client';
    interface Row { id: string; courseName: string; firstStart: string | null; occupied: number; maxSeats: number; waitlist: number; status: string }
    const form = $<HTMLFormElement>('#filters');
    async function load() {
      const status = new FormData(form).get('status');
      try {
        const r = await api<{ items: Row[] }>(`/admin/editions${status ? `?status=${status}` : ''}`);
        $('#rows').innerHTML = r.items.length
          ? r.items.map((e) => {
              const pct = Math.round((e.occupied / e.maxSeats) * 100);
              return `<tr><td><strong>${esc(e.courseName)}</strong></td><td>${fmtBogota(e.firstStart)}</td>
                <td><progress max="${e.maxSeats}" value="${e.occupied}" aria-label="Ocupación"></progress> ${e.occupied}/${e.maxSeats} (${pct}%)</td>
                <td class="num">${e.waitlist}</td><td><span class="badge ${e.status === 'abierta' ? 'badge--solid' : 'badge--mute'}">${esc(e.status)}</span></td>
                <td class="actions"><a class="btn btn--sm" href="/admin/ediciones/${e.id}/inscritos">Inscritos</a><a class="btn btn--sm" href="/admin/ediciones/${e.id}">Editar</a></td></tr>`;
            }).join('')
          : '<tr><td colspan="6" class="empty">No hay ediciones</td></tr>';
      } catch (err) { toast(errorMessage(err), 'error'); }
    }
    form.addEventListener('submit', (e) => { e.preventDefault(); void load(); });
    void load();
  </script>
  <style is:global>
    progress { width: 6rem; height: 0.8rem; accent-color: var(--color-ink); vertical-align: middle; }
  </style>
</AdminLayout>
