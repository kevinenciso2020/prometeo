---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Pedidos" active="pedidos">
  <div class="page-head"><h1>Pedidos</h1></div>
  <form class="toolbar" id="filters">
    <input class="input" type="search" name="q" placeholder="N.º de pedido, nombre o correo" aria-label="Buscar" />
    <select class="select" name="status" aria-label="Estado">
      <option value="">Todos los estados</option>
      <option value="pendiente_pago">Pendiente de pago</option><option value="pagado">Pagado</option><option value="preparando">Preparando</option>
      <option value="enviado">Enviado</option><option value="entregado">Entregado</option><option value="cancelado">Cancelado</option>
    </select>
    <label class="check"><input type="checkbox" name="review" /> Solo en revisión</label>
    <button class="btn" type="submit">Filtrar</button>
  </form>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Pedido</th><th>Cliente</th><th>Fecha</th><th>Estado</th><th class="num">Total</th><th></th></tr></thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
  <div class="pager"><button class="btn btn--sm" id="prev" type="button">Anterior</button><span id="info"></span><button class="btn btn--sm" id="next" type="button">Siguiente</button></div>

  <script>
    import { $, api, errorMessage, esc, fmtBogota, formatCop, toast } from '../../../lib/admin-client';
    interface Row { id: string; code: string; contactName: string; contactEmail: string; createdAt: string; statusLabel: string; status: string; total: number; needsReview: boolean }
    interface Page { items: Row[]; page: number; totalPages: number; total: number }
    let page = 1;
    const form = $<HTMLFormElement>('#filters');
    async function load() {
      const d = new FormData(form);
      const p = new URLSearchParams({ page: String(page), pageSize: '20' });
      if (d.get('q')) p.set('q', String(d.get('q')));
      if (d.get('status')) p.set('status', String(d.get('status')));
      if (d.get('review')) p.set('review', 'true');
      try {
        const r = await api<Page>(`/admin/orders?${p}`);
        $('#rows').innerHTML = r.items.length
          ? r.items.map((o) => `<tr><td><a href="/admin/pedidos/${o.id}"><strong>${esc(o.code)}</strong></a>${o.needsReview ? ' <span class="badge badge--solid">Revisar</span>' : ''}</td>
              <td>${esc(o.contactName)}<br><small>${esc(o.contactEmail)}</small></td><td>${fmtBogota(o.createdAt)}</td>
              <td><span class="badge ${['pagado', 'preparando', 'enviado', 'entregado'].includes(o.status) ? 'badge--solid' : 'badge--mute'}">${esc(o.statusLabel)}</span></td>
              <td class="num">${formatCop(o.total)}</td><td class="actions"><a class="btn btn--sm" href="/admin/pedidos/${o.id}">Abrir</a></td></tr>`).join('')
          : '<tr><td colspan="6" class="empty">No hay pedidos con estos filtros</td></tr>';
        $('#info').textContent = `Página ${r.page} de ${r.totalPages} · ${r.total} pedidos`;
        $<HTMLButtonElement>('#prev').disabled = r.page <= 1;
        $<HTMLButtonElement>('#next').disabled = r.page >= r.totalPages;
      } catch (err) { toast(errorMessage(err), 'error'); }
    }
    form.addEventListener('submit', (e) => { e.preventDefault(); page = 1; void load(); });
    $('#prev').addEventListener('click', () => { page--; void load(); });
    $('#next').addEventListener('click', () => { page++; void load(); });
    void load();
  </script>
</AdminLayout>
