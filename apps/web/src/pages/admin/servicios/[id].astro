---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ImageUploader from '../../../components/ImageUploader.astro';
const { id } = Astro.params;
---

<AdminLayout title="Servicio" active="servicios">
  <div class="page-head">
    <h1 id="title">Servicio</h1>
    <div class="actions"><a class="btn" href="/admin/servicios">Volver</a><button class="btn btn--danger" id="delete" type="button" hidden>Eliminar</button></div>
  </div>
  <form id="form" class="stack" data-id={id} novalidate>
    <div class="card stack">
      <div class="grid-2">
        <div class="field"><label for="name">Nombre</label><input class="input" id="name" name="name" required /></div>
        <div class="field"><label for="slug">Slug (URL)</label><input class="input" id="slug" name="slug" required /></div>
      </div>
      <div class="field"><label for="description">Descripción</label><textarea class="textarea" id="description" name="description"></textarea></div>
      <div class="grid-2">
        <div class="field"><label for="mode">Modo</label>
          <select class="select" id="mode" name="mode"><option value="cotizacion">Cotización (formulario)</option><option value="pago_online">Pago online</option></select></div>
        <div class="field"><label for="price">Precio (COP)</label><input class="input" id="price" name="price" type="number" min="0" step="1" /><span class="hint">Obligatorio en pago online; opcional como "desde" en cotización.</span></div>
        <div class="field"><label for="status">Estado</label>
          <select class="select" id="status" name="status"><option value="borrador">Borrador</option><option value="publicado">Publicado</option><option value="archivado">Archivado</option></select></div>
        <div class="field"><label for="sortOrder">Orden</label><input class="input" id="sortOrder" name="sortOrder" type="number" min="0" value="0" /></div>
      </div>
    </div>
    <div class="card"><ImageUploader folder="prometeo/services" label="Imágenes" /></div>
    <p class="form-error" id="error" role="alert"></p>
    <div><button class="btn btn--primary" type="submit">Guardar servicio</button></div>
  </form>

  <script>
    import { slugify } from '@prometeo/shared';
    import { $, api, errorMessage, fillForm, readForm, toast } from '../../../lib/admin-client';
    type Img = { url: string; publicId: string; alt: string | null; isPrimary: boolean };
    type Uploader = HTMLElement & { getImages(): Img[]; setImages(i: Img[]): void; markSaved(): void };
    const form = $<HTMLFormElement>('#form');
    const uploader = $<Uploader>('image-uploader');
    const error = $('#error');
    const id = form.dataset.id && form.dataset.id !== 'nuevo' ? form.dataset.id : null;

    async function init() {
      if (!id) { $('#title').textContent = 'Nuevo servicio'; return; }
      const { item } = await api<{ item: Record<string, unknown> & { images: Img[] } }>(`/admin/services/${id}`);
      $('#title').textContent = String(item.name);
      fillForm(form, item);
      uploader.setImages(item.images);
      $<HTMLButtonElement>('#delete').hidden = false;
    }
    $<HTMLInputElement>('#name').addEventListener('input', (e) => {
      const slug = $<HTMLInputElement>('#slug');
      if (!id && !slug.dataset.touched) slug.value = slugify((e.target as HTMLInputElement).value);
    });
    $<HTMLInputElement>('#slug').addEventListener('input', (e) => ((e.target as HTMLElement).dataset.touched = '1'));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.textContent = '';
      const v = readForm(form);
      const body = { ...v, sortOrder: v.sortOrder ?? 0, images: uploader.getImages() };
      try {
        const r = id ? await api<{ item: { id: string } }>(`/admin/services/${id}`, 'PUT', body) : await api<{ item: { id: string } }>('/admin/services', 'POST', body);
        uploader.markSaved();
        toast('Servicio guardado');
        if (!id) location.href = `/admin/servicios/${r.item.id}`;
      } catch (err) {
        error.textContent = errorMessage(err);
      }
    });
    $('#delete').addEventListener('click', async () => {
      if (!id || !confirm('¿Eliminar este servicio? No se puede deshacer.')) return;
      try { await api(`/admin/services/${id}`, 'DELETE'); location.href = '/admin/servicios'; } catch (err) { toast(errorMessage(err), 'error'); }
    });
    void init();
  </script>
</AdminLayout>
