---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Servicios" active="servicios">
  <div class="page-head">
    <h1>Servicios</h1>
    <a class="btn btn--primary" href="/admin/servicios/nuevo">Nuevo servicio</a>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Servicio</th><th>Modo</th><th class="num">Precio</th><th>Estado</th><th></th></tr></thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
  <script>
    import { $, api, errorMessage, esc, formatCop, toast } from '../../../lib/admin-client';
    interface Row { id: string; name: string; mode: string; price: number | null; status: string }
    void api<{ items: Row[] }>('/admin/services?pageSize=100')
      .then((r) => {
        $('#rows').innerHTML = r.items.length
          ? r.items.map((x) => `<tr><td><a href="/admin/servicios/${x.id}"><strong>${esc(x.name)}</strong></a></td>
              <td>${x.mode === 'pago_online' ? 'Pago online' : 'Cotización'}</td><td class="num">${x.price === null ? '—' : formatCop(x.price)}</td>
              <td><span class="badge ${x.status === 'publicado' ? 'badge--solid' : 'badge--mute'}">${esc(x.status)}</span></td>
              <td class="actions"><a class="btn btn--sm" href="/admin/servicios/${x.id}">Editar</a></td></tr>`).join('')
          : '<tr><td colspan="5" class="empty">Aún no hay servicios</td></tr>';
      })
      .catch((e) => toast(errorMessage(e), 'error'));
  </script>
</AdminLayout>
