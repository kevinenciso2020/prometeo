---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/LegalPage.astro';
import { getSettings } from '../lib/site';

const s = await getSettings();
---

<BaseLayout title="Política de privacidad" description="Política de tratamiento de datos personales de Prometeo (Ley 1581 de 2012).">
  <div class="container section">
    <h1>Política de privacidad</h1>
    <LegalPage text={s.legal.privacy} />
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-5);
  }
</style>
