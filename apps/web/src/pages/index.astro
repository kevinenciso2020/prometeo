---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import ProductCard from '../components/ProductCard.astro';
import { apiGet, fmtDay, SITE_URL, type CategoryData, type CourseListItem, type Paged, type ProductCardData, type ServiceData } from '../lib/site';
import { ogImage } from '../lib/images';
import CampaignBanner from '../components/CampaignBanner.astro';
import { byPlacement, pageCampaigns } from '../lib/campaigns';

const [featured, categories, services, courses] = await Promise.all([
  apiGet<Paged<ProductCardData>>('/public/products?featured=true&pageSize=4'),
  apiGet<{ items: CategoryData[] }>('/public/categories'),
  apiGet<{ items: ServiceData[] }>('/public/services'),
  apiGet<{ items: CourseListItem[] }>('/public/courses'),
]);
const upcoming = (courses?.items ?? []).filter((c) => c.nextEdition).slice(0, 3);
const campaigns = await pageCampaigns(Astro.locals, Astro.url.pathname);
const heroCampaign = byPlacement(campaigns, 'hero_banner')[0];
const sectionBanners = byPlacement(campaigns, 'banner_seccion');
const heroImage = featured?.items.find((p) => p.image)?.image ?? null;
const HERO_PHOTO = '/img/hero-torno.jpg';
---

<BaseLayout
  description="Taller de cerámica artesanal: piezas únicas hechas a mano, cursos de torno y modelado, y encargos personalizados."
  image={ogImage(heroImage)}
  structuredData={{ '@context': 'https://schema.org', '@type': 'Organization', name: 'Prometeo', url: SITE_URL }}
>
  {heroCampaign && <CampaignBanner campaign={heroCampaign} hero />}
  <section class="hero">
    <div class="container hero__in">
      <div class="hero__text">
        <p class="eyebrow">Taller de cerámica artesanal</p>
        <h1>Barro, fuego<br />y manos.</h1>
        <p>Piezas únicas hechas a mano, cursos para aprender el oficio y encargos a tu medida.</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="/tienda">Ver la tienda</a>
          <a class="btn" href="/servicios">Servicios</a>
        </div>
      </div>
      <div class="hero__frame">
        <Picture src={HERO_PHOTO} alt="Manos de alfarero dando forma al barro sobre el torno" ratio="4 / 5" width={1024} sizes="(min-width: 60rem) 40vw, 90vw" eager class="hero__pic" />
      </div>
    </div>
  </section>

  {
    categories && categories.items.length > 0 && (
      <section class="strip" aria-label="Categorías">
        <ul class="container" role="list">
          {categories.items.map((c) => <li><a href={`/tienda?category=${c.slug}`}>{c.name}</a></li>)}
        </ul>
      </section>
    )
  }

  {sectionBanners.map((b) => <CampaignBanner campaign={b} />)}

  <section class="section container">
    <div class="head"><h2>Destacados</h2><a class="link-arrow" href="/tienda">Ver todo →</a></div>
    {
      featured && featured.items.length > 0 ? (
        <div class="grid">{featured.items.map((p, i) => <ProductCard product={p} eager={i < 2} />)}</div>
      ) : (
        <p class="muted">Pronto publicaremos nuevas piezas.</p>
      )
    }
  </section>

  <section class="kiln" aria-label="El taller">
    <div class="container kiln__in">
      <div class="kiln__text">
        <h2>Cada pieza pasa por nuestras manos y por el horno.</h2>
        <p>Hornadas pequeñas, esmaltes propios y barro de la región. Por eso no hay dos piezas iguales.</p>
        <a class="btn" href="/el-taller">Conoce el taller</a>
      </div>
    </div>
  </section>

  {
    services && services.items.length > 0 && (
      <section class="section container">
        <div class="head"><h2>Servicios</h2><a class="link-arrow" href="/servicios">Ver servicios →</a></div>
        <ul class="svc" role="list">
          {services.items.slice(0, 3).map((s) => (
            <li>
              <a href={`/servicios/${s.slug}`}>
                <Picture src={s.image} alt={s.name} ratio="4 / 3" sizes="(min-width: 60rem) 30vw, 90vw" />
                <h3>{s.name}</h3>
                <p>{s.description.slice(0, 120)}{s.description.length > 120 ? '…' : ''}</p>
                <span class="link-arrow">Conocer más →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    upcoming.length > 0 ? (
      <section class="section container">
        <div class="head"><h2>Próximos cursos</h2><a class="link-arrow" href="/cursos">Ver todos →</a></div>
        <ul class="svc" role="list">
          {upcoming.map((c) => (
            <li>
              <a href={`/cursos/${c.slug}`}>
                <Picture src={c.image} alt={c.name} ratio="4 / 3" sizes="(min-width: 60rem) 30vw, 90vw" />
                <p class="eyebrow">{c.nextEdition?.startsAt ? fmtDay(c.nextEdition.startsAt) : 'Próximamente'}</p>
                <h3>{c.name}</h3>
                <p>{c.nextEdition?.full ? 'Lista de espera' : `${c.nextEdition?.seatsLeft} cupos disponibles`}</p>
                <span class="link-arrow">Ver edición →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <section class="band">
        <div class="container band__in">
          <h2>Aprende a trabajar el barro</h2>
          <p>Muy pronto abriremos las inscripciones a nuestros cursos de cerámica. Escríbenos para enterarte primero.</p>
          <a class="btn" href="/contacto">Quiero que me avisen</a>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    border-bottom: var(--border-w) solid var(--color-line);
    background: var(--color-terracotta);
    color: #fff;
  }
  .hero .eyebrow {
    color: var(--color-sand);
  }
  .hero .btn--primary {
    background: var(--color-cafe-deep);
  }
  .hero .btn--primary:hover {
    background: var(--color-ink);
  }
  .hero :focus-visible {
    outline-color: #fff;
  }
  .hero__frame {
    position: relative;
  }
  .hero__in {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-7);
    align-items: center;
    padding-block: var(--space-7);
  }
  .hero__text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  h1 {
    font-size: var(--text-3xl);
  }
  .hero__text p:not(.eyebrow) {
    font-size: var(--text-lg);
    max-width: 30rem;
  }
  .hero__cta {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  :global(.hero__pic) {
    border: var(--border-w) solid var(--color-line);
    box-shadow: 8px 8px 0 var(--color-cafe-deep);
  }
  .strip {
    border-bottom: var(--border-w) solid var(--color-line);
    background: var(--color-cafe-deep);
    color: var(--color-inverse-ink);
  }
  .strip ul {
    display: flex;
    gap: var(--space-6);
    padding-block: var(--space-3);
    overflow-x: auto;
    white-space: nowrap;
  }
  .strip a {
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
  }
  .strip a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-terracotta);
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .strip :focus-visible {
    outline-color: var(--color-inverse-ink);
  }
  .kiln {
    margin-top: var(--section-y);
    border-block: var(--border-w) solid var(--color-line);
    background:
      linear-gradient(90deg, rgb(58 34 24 / 0.92) 0%, rgb(58 34 24 / 0.78) 45%, rgb(58 34 24 / 0.15) 100%),
      url('/img/terracota.jpg') center / cover;
    color: var(--color-inverse-ink);
  }
  .kiln__in {
    padding-block: var(--section-y);
  }
  .kiln__text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 34rem;
  }
  .kiln h2 {
    font-size: var(--text-2xl);
  }
  .kiln :focus-visible {
    outline-color: var(--color-inverse-ink);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: var(--space-5);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-6) var(--space-5);
  }
  .svc {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5);
    padding: 0;
  }
  .svc a {
    display: grid;
    gap: var(--space-2);
    height: 100%;
    align-content: start;
    padding: var(--space-4);
    border: var(--border-w) solid var(--color-line);
    text-decoration: none;
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .svc a:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--color-terracotta);
  }
  .band {
    background: var(--color-inverse-bg);
    color: var(--color-inverse-ink);
    padding-block: var(--space-7);
  }
  .band__in {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .svc :global(.pic) {
    margin-bottom: var(--space-2);
    border: var(--border-w) solid var(--color-line);
  }
  .band .btn {
    box-shadow: 2px 2px 0 var(--color-inverse-ink);
  }
  .band :focus-visible {
    outline-color: var(--color-inverse-ink);
  }
  .muted {
    color: var(--color-ink-mute);
  }
  @media (max-width: 760px) {
    .hero__in {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
