---
import { LEGAL_DEFAULTS } from '../lib/legal-defaults';
interface Props {
  text: string;
  kind?: keyof typeof LEGAL_DEFAULTS;
}
const { text, kind } = Astro.props;
const content = text.trim() || (kind ? LEGAL_DEFAULTS[kind] : '');
const blocks = content ? content.split(/\n{2,}/) : [];
---

<div class="prose">
  {
    blocks.length ? (
      blocks.map((b) => <p>{b}</p>)
    ) : (
      <p>Este contenido aún no ha sido publicado. Escríbenos si necesitas información.</p>
    )
  }
</div>

<style>
  p {
    white-space: pre-line;
  }
</style>
