---
interface Props {
  text: string;
}
const { text } = Astro.props;
const blocks = text.trim() ? text.trim().split(/\n{2,}/) : [];
---

<div class="prose">
  {
    blocks.length ? (
      blocks.map((b) => <p>{b}</p>)
    ) : (
      <p>Este contenido aún no ha sido publicado. Escríbenos si necesitas información.</p>
    )
  }
</div>

<style>
  p {
    white-space: pre-line;
  }
</style>
