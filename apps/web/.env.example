# Variables PUBLIC_* van al navegador: nunca pongas secretos aquí.
# Copia a apps/web/.env para desarrollo local.
PUBLIC_API_URL=http://localhost:8787
PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
# URL pública del sitio (canonical, sitemap, Open Graph). En producción: https://tu-dominio.com
PUBLIC_SITE_URL=http://localhost:4321
