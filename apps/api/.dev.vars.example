# Copia este archivo a .dev.vars (está en .gitignore). Wrangler lo carga en `pnpm dev`.
# En producción estos valores se cargan con: wrangler secret put <NOMBRE>

# Cadena de Neon. Para el Worker usa la cadena POOLED (host con -pooler) o la directa.
DATABASE_URL="postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/prometeo?sslmode=require"

# Clave para firmar los JWT. Genera una con: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Opcional en local: si falta, los correos se imprimen en la consola.
# RESEND_API_KEY="re_xxxxxxxxxxxx"

# Cloudinary (Dashboard > API Keys). El API_SECRET NUNCA llega al navegador.
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="tu-api-secret"

# Wompi (Dashboard > Desarrolladores > Secretos para integración técnica). Usa las llaves de SANDBOX en local.
# La llave pública va en wrangler.toml ([vars] WOMPI_PUBLIC_KEY). Estos dos son secretos:
WOMPI_INTEGRITY_SECRET="test_integrity_xxxxxxxxxxxxxxxx"
WOMPI_EVENTS_SECRET="test_events_xxxxxxxxxxxxxxxx"
# URL de eventos a configurar en Wompi: https://api.<dominio>/webhooks/wompi
