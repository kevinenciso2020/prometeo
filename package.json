{
  "name": "prometeo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @prometeo/api --filter @prometeo/web dev",
    "dev:api": "pnpm --filter @prometeo/api dev",
    "dev:web": "pnpm --filter @prometeo/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @prometeo/db generate",
    "db:migrate": "pnpm --filter @prometeo/db migrate",
    "db:migrate:ci": "pnpm --filter @prometeo/db migrate:ci",
    "db:seed": "pnpm --filter @prometeo/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "@prometeo/config": "workspace:*"
  }
}
