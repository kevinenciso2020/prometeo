# ---------------------------------------------------------------
# .env  (raíz) — SOLO para comandos locales de base de datos
# (migraciones y seed). Nunca se sube a git.
# Los secretos del Worker van en apps/api/.dev.vars (local) o
# `wrangler secret put` (producción).
# ---------------------------------------------------------------

# Cadena de conexión DIRECTA de Neon (con sslmode=require).
# Neon > Connection details > desactiva "Pooled connection" para migrar.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/prometeo?sslmode=require

# Administrador inicial que crea `pnpm db:seed` (rol SUPER_ADMIN)
ADMIN_EMAIL=admin@prometeo.local
ADMIN_PASSWORD=cambia-esta-clave-larga-123
ADMIN_NAME=Administrador Prometeo
